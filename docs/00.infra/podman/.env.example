# render.sh가 *.template.yaml을 치환할 때 쓰는 값이다.
# 복사해서 .env를 만들고 값을 채운다. (.env는 Git에서 제외된다)
#   cp .env.example .env

# 파드, 시크릿, 볼륨 이름의 접두어 (소문자, 숫자, -)
PROJECT=module

# 호스트 포트 (같은 머신의 다른 프로젝트와 겹치지 않게 정한다)
POSTGRES_PORT=55432
REDIS_PORT=56379
NEO4J_HTTP_PORT=57474
NEO4J_BOLT_PORT=57687

# 계정 (볼륨이 처음 만들어질 때만 반영된다)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
NEO4J_USER=neo4j
# 8자 이상이어야 한다
NEO4J_PASSWORD=
