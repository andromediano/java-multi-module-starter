# 로컬 개발 환경변수. 복사해서 .env를 만들고 값을 채운다. (.env는 Git에서 제외된다)
#   cp .env.example .env
#
# 이 파일 하나를 두 곳이 함께 읽는다.
#   - 앱: mise(터미널) 또는 IntelliJ Run Configuration이 환경변수로 넣는다
#   - Podman: docs/00.infra/podman/render.sh가 pod.yaml, secret.yaml을 만들 때 읽는다
# 읽는 쪽 파서가 서로 다르므로 KEY=value 형식으로 쓴다.
# 특수문자가 있으면 작은따옴표로 감싸고, $는 쓰지 않는다.

# 파드, 시크릿, 볼륨 이름의 접두어 (소문자, 숫자, -)
PROJECT=module

# PostgreSQL 접속 정보. 운영에서도 같은 이름의 환경변수로 넣는다.
# DB_PORT는 Podman의 호스트 포트가 되고, 계정과 DB 이름은 볼륨이 처음 만들어질 때만 반영된다.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# 호스트 포트 (같은 머신의 다른 프로젝트와 겹치지 않게 정한다)
REDIS_PORT=56379
NEO4J_HTTP_PORT=57474
NEO4J_BOLT_PORT=57687

# Neo4j 계정 (볼륨이 처음 만들어질 때만 반영된다)
NEO4J_USER=neo4j
# 8자 이상이어야 한다
NEO4J_PASSWORD=
